# Next.js Frontend Environment Variables
# Copy this file to .env.local and update the values

# ==========================================
# Laravel Backend API Configuration
# ==========================================

# Base URL for Laravel API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Frontend URL (for CORS reference)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Optional: Third-party Services
# ==========================================

# Payment Gateway (if integrating real payment providers)
# NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=your_payment_key_here

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# ==========================================
# Note: Do not add private keys or secrets here
# These will be exposed to the browser
# ==========================================
